# Frontend configuration — copy to .env.local and fill in after deployment.
# Only public values here. NEVER put a private key in a NEXT_PUBLIC_ variable.

# Deployed PixelTurf address on Base Sepolia (chain id 84532)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Block at which the contract was deployed (start of event history)
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# RPC used for reads and event logs
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Optional, local development only: point the app at an Anvil node (chain 31337).
# Leave unset for normal use — the app targets Base Sepolia exclusively.
# NEXT_PUBLIC_DEV_RPC_URL=http://127.0.0.1:8545
