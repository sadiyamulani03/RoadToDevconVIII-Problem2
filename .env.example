# --- Deployment (server-side only; NEVER commit the real .env) ---

# RPC endpoint for Base Sepolia (chain id 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private key of a throwaway, TESTNET-ONLY account funded with Base Sepolia ETH.
# Leave empty until you are ready to deploy. Never reuse a mainnet key.
PRIVATE_KEY=

# Optional: for `forge script ... --verify` on Basescan
BASESCAN_API_KEY=

# --- Frontend (frontend/.env.local) ---
# Only public configuration goes here. No private keys, ever.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
